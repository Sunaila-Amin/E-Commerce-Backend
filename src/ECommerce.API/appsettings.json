{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ECommerceDb;Integrated Security=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Jwt": {
    "Key": "SuperSecretKeyForECommerceJwtSigning_ChangeThisInProduction_0123456789",
    "Issuer": "ECommerce",
    "Audience": "ECommerceClient",
    "ExpiryMinutes": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
